# SÉCURITÉ : Vos futurs secrets iront dans le fichier ".env" (ignoré par Git).
# Ce fichier ".env.example" est public et sert uniquement de modèle pour GitHub.

# DB_PASSWORD : À changer pour la "production", reste générique en dev local.
# (OWASP A01:2021 : Broken Access Control prevention via secret management)
POSTGRES_PASSWORD=votre_mot_de_passe_secret

# L'URL ENCODÉE (Assurez-vous qu'elle correspond à POSTGRES_PASSWORD)
DATABASE_URL=postgresql://plume_admin:votre_mot_de_passe_secret@postgres:5432/plume_ai

# API GROQ : Votre sésame pour l'IA. 
GROQ_API_KEY=METTRE_VOTRE_CLE_ICI

# SÉCURITÉ JWT (OAuth2)
JWT_SECRET_KEY=JWT_SECRET_PLACEHOLDER_ANSSI
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200 # 30 jours (60 * 24 * 30)
