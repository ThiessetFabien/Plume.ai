# SÉCURITÉ : Vos secrets réels doivent être placés dans le fichier ".env" (ignoré par Git).
# Ce fichier ".env.example" est public et sert uniquement de modèle pour GitHub.

# DB_PASSWORD : À changer pour la "production".
# (OWASP A01:2021 : Broken Access Control prevention via secret management)
POSTGRES_PASSWORD=votre_mot_de_passe_secret_ici

# L'URL ENCODÉE (Assurez-vous qu'elle correspond à POSTGRES_PASSWORD)
DATABASE_URL=postgresql://plume_admin:votre_mot_de_passe_secret_ici@postgres:5432/plume_ai

# API GROQ : Votre sésame pour l'IA (Copilot). 
GROQ_API_KEY=VOTRE_CLE_GROQ_GSA_XXX

# SÉCURITÉ JWT (OAuth2)
# Générez une clé via : openssl rand -hex 32
JWT_SECRET_KEY=VOTRE_JWT_SECRET_KEY_GÉNÉRÉE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# SÉCURITÉ CHIFFREMENT (Fernet)
# Générez une clé via : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLUME_ENCRYPTION_KEY=VOTRE_CLE_FERNET_GÉNÉRÉE

# IDENTIFIANTS DE DÉVELOPPEMENT (Placeholders)
# Ces identifiants servent de modèle pour le peuplement de la base (seed.py).
DEFAULT_PLAYER_PASSWORD=votre_mot_de_passe_joueur_par_défaut
