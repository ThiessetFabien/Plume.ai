{
  "include": [
    "backend",
    "scratch"
  ],
  "exclude": [
    "mobile",
    "**/node_modules",
    "**/__pycache__"
  ],
  "executionEnvironments": [
    {
      "root": "backend",
      "pythonVersion": "3.14",
      "extraPaths": [
        "."
      ]
    },
    {
      "root": "scratch",
      "pythonVersion": "3.14",
      "extraPaths": [
        "../backend"
      ]
    }
  ],
  "venvPath": ".",
  "venv": "venv",
  "reportMissingModuleSource": "none",
  "extraPaths": [
    "./backend"
  ],
  "typeCheckingMode": "basic",
  "pythonVersion": "3.14",
  "pythonPlatform": "Linux"
}
