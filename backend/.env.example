# SÉCURITÉ : Vos futurs secrets iront dans le fichier ".env" (ignoré par Git).
# Ce fichier ".env.example" est public et sert uniquement de modèle pour GitHub.

# Connexion à notre base de données locale (PostgreSQL) config dans Docker Hub
# (POSTGRES_PASSWORD doit correspondre à ce qui est dans DATABASE_URL)
POSTGRES_PASSWORD=plume_super_secret_password
DATABASE_URL=postgresql://plume_admin:plume_super_secret_password@postgres:5432/plume_ai

# Clé API pour LLaMa 3 (Groq) - Obtenir sur console.groq.com
GROQ_API_KEY=your_dummy_groq_api_key_here
