{
  "include": [
    "backend",
    "scratch"
  ],
  "exclude": [
    "mobile",
    "**/node_modules",
    "**/__pycache__",
    "venv",
    "**/venv",
    ".ruff_cache",
    ".pytest_cache"
  ],
  "venvPath": ".",
  "venv": "venv",
  "executionEnvironments": [
    {
      "root": "backend",
      "extraPaths": [
        "."
      ]
    },
    {
      "root": "scratch",
      "extraPaths": [
        "../backend"
      ]
    }
  ],
  "extraPaths": [
    "./backend"
  ],
  "reportMissingImports": "warning",
  "typeCheckingMode": "basic",
  "pythonVersion": "3.14",
  "pythonPlatform": "Linux"
}
